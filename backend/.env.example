# Copy to .env and fill in the values you need. Only the providers you
# actually select below require their corresponding API key.

VETSCRIBE_TRANSCRIPTION_PROVIDER=openai
VETSCRIBE_NOTE_PROVIDER=openai

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

OPENAI_TRANSCRIPTION_MODEL=whisper-1
OPENAI_NOTE_MODEL=gpt-4o-mini
ANTHROPIC_NOTE_MODEL=claude-sonnet-4-5
GEMINI_TRANSCRIPTION_MODEL=gemini-2.5-flash
GEMINI_NOTE_MODEL=gemini-2.5-flash
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_NOTE_MODEL=gemma4:e4b

# Shared secret Vet Soap Notetaker's Settings "API Key" field must match. Leave blank
# to accept unauthenticated requests.
VETSCRIBE_BACKEND_API_KEY=
