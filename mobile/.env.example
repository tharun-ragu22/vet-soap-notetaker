# Vet Soap Notetaker Mobile configuration. Copy this file to `.env` and fill in the values.
# Expo loads `.env` automatically; only EXPO_PUBLIC_* vars are exposed to the app.
# `.env` is git-ignored — never commit real secrets. No host OS env vars required.

# Base URL of the Vet Soap Notetaker backend (the same server the desktop tray app POSTs to).
# Use your machine's LAN IP (not localhost) so a physical phone can reach it.
EXPO_PUBLIC_VETSCRIBE_API_URL=http://192.168.1.50:8000

# Shared bearer secret; must match the backend's VETSCRIBE_BACKEND_API_KEY.
# Leave blank if the backend runs unauthenticated.
EXPO_PUBLIC_VETSCRIBE_API_KEY=
